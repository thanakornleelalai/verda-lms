generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  SUPERADMIN
}

enum CourseStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  LIVE
  ASSIGNMENT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Gateway {
  STRIPE
  OMISE
  FREE
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
  SHORT_ANSWER
}

enum ThreadStatus {
  OPEN
  RESOLVED
  LOCKED
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

// ── Auth (NextAuth / Auth.js) ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  image         String?
  role          UserRole  @default(STUDENT)
  passwordHash  String?
  bio           String?
  headline      String?
  website       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  enrollments   Enrollment[]
  orders        Order[]
  attempts      Attempt[]
  progress      UserCourseProgress[]
  certificates  Certificate[]
  threads       Thread[]
  posts         Post[]
  votes         PostVote[]
  points        UserPoints?
  badges        UserBadge[]
  streaks       StreakRecord[]
  courses       Course[]         @relation("InstructorCourses")
  instructorApplication InstructorApplication?
  tenantId      String?
  tenant        Tenant?          @relation(fields: [tenantId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Courses ───────────────────────────────────────────────────────────────────

model Course {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  description     String
  longDescription String?
  thumbnail       String?
  monogram        String?
  art             String?
  price           Int          @default(0) // THB satang
  currency        String       @default("THB")
  level           CourseLevel  @default(BEGINNER)
  status          CourseStatus @default(DRAFT)
  language        String       @default("th")
  tags            String[]
  totalDuration   Int          @default(0) // seconds
  rating          Float        @default(0)
  ratingCount     Int          @default(0)
  enrollmentCount Int          @default(0)
  instructorId    String
  instructor      User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id])
  sections        Section[]
  enrollments     Enrollment[]
  orders          OrderItem[]
  certificates    Certificate[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenantId        String?
  tenant          Tenant?      @relation(fields: [tenantId], references: [id])
}

model Category {
  id      String   @id @default(cuid())
  slug    String   @unique
  label   String
  icon    String?
  count   Int      @default(0)
  courses Course[]
}

model Section {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  lessons   Lesson[]
  createdAt DateTime @default(now())
}

model Lesson {
  id          String     @id @default(cuid())
  sectionId   String
  section     Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  type        LessonType @default(VIDEO)
  order       Int
  duration    Int?       // seconds
  videoAsset  String?    // Mux asset ID
  playbackId  String?    // Mux playback ID
  content     String?    // Tiptap JSON
  isFree      Boolean    @default(false)
  drip        Int?       // days after enrollment
  quizzes     Quiz[]
  progress    LessonProgress[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ── Enrollments & Progress ────────────────────────────────────────────────────

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime @default(now())
  expiresAt   DateTime?
  completedAt DateTime?
  progress    UserCourseProgress?

  @@unique([userId, courseId])
}

model UserCourseProgress {
  id           String     @id @default(cuid())
  userId       String
  courseId     String
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressPct  Int        @default(0)
  lastLesson   String?
  updatedAt    DateTime   @updatedAt

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  watchedPct  Int      @default(0)
  completed   Boolean  @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

// ── Quiz ──────────────────────────────────────────────────────────────────────

model Quiz {
  id           String    @id @default(cuid())
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  timeLimitSec Int?
  passingScore Int       @default(70)
  questions    Question[]
  attempts     Attempt[]
  createdAt    DateTime  @default(now())
}

model Question {
  id       String         @id @default(cuid())
  quizId   String
  quiz     Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text     String
  type     QuestionType   @default(SINGLE)
  order    Int
  points   Int            @default(1)
  options  QuestionOption[]
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
}

model Attempt {
  id          String    @id @default(cuid())
  userId      String
  quizId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     Json      // { questionId: optionId[] }
  score       Int?
  passed      Boolean?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
}

// ── Orders & Payments ─────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  total       Int         // THB satang
  currency    String      @default("THB")
  status      OrderStatus @default(PENDING)
  gateway     Gateway
  gatewayRef  String?
  couponId    String?
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  courseId String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id])
  price    Int
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Int       // 0–100
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  orders      Order[]
}

// ── Certificates ──────────────────────────────────────────────────────────────

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pdfUrl      String?
  issuedAt    DateTime @default(now())

  @@unique([userId, courseId])
}

// ── Forum ─────────────────────────────────────────────────────────────────────

model Thread {
  id        String       @id @default(cuid())
  courseId  String
  lessonId  String?
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  status    ThreadStatus @default(OPEN)
  posts     Post[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Post {
  id        String     @id @default(cuid())
  threadId  String
  userId    String
  thread    Thread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  votes     PostVote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model PostVote {
  id     String @id @default(cuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  value  Int    // +1 or -1

  @@unique([postId, userId])
}

// ── Gamification ──────────────────────────────────────────────────────────────

model UserPoints {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  total     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String
  tier        BadgeTier   @default(BRONZE)
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model StreakRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  count     Int      @default(1)

  @@unique([userId, date])
}

// ── Notes ─────────────────────────────────────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

// ── Analytics ─────────────────────────────────────────────────────────────────

model ProgressEvent {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  lessonId  String
  eventType String   // PLAY, PAUSE, COMPLETE, SEEK
  position  Int?     // seconds
  meta      Json?
  createdAt DateTime @default(now())
}

// ── Instructor Application ────────────────────────────────────────────────────

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model InstructorApplication {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(PENDING)

  // Applicant profile
  fullName    String
  email       String
  headline    String            // e.g. "Lead UX Designer @ SCB"
  expertise   String            // main subject area
  bio         String            @db.Text
  experience  String            // years / background
  courseIdea  String            @db.Text // proposed first course
  linkedIn    String?
  website     String?
  portfolio   String?

  // Admin review
  reviewNote  String?           @db.Text
  reviewedBy  String?
  reviewedAt  DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// ── Multi-tenant ──────────────────────────────────────────────────────────────

model Tenant {
  id       String   @id @default(cuid())
  slug     String   @unique
  name     String
  domain   String?  @unique
  logoUrl  String?
  plan     String   @default("starter")
  users    User[]
  courses  Course[]
  settings Json?
}
